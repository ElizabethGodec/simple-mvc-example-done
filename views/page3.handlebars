<html lang="en">

<head>
  <meta charset="utf-8" />
  <!-- passed in variables in handlebars are surrounded by two curly braces like the following
       Any variable you pass into res.render will be available by name in the template through
       the curly braces
  -->
  <title>{{title}}</title>
</head>

<body>
  <h1>Welcome to page 3</h1>

  <!-- links or URLs are always GET resources as they are getting (retrieving) a resource -->
  <a href="/">Home</a>
  <a href="/page1">Page 1</a>
  <a href="/page2">Page 2</a>
  <a href="/page4">Page 4</a>

  <h2>Create a New Dog</h2>

  <form action="/createDog" method="POST">
    <label for="dogName">Dog Name:</label>
    <input type="text" id="dogName" name="name" required>
    <br><br>

    <label for="dogBreed">Breed:</label>
    <input type="text" id="dogBreed" name="breed" required>
    <br><br>

    <label for="dogAge">Age:</label>
    <input type="number" id="dogAge" name="age" min="0" required>
    <br><br>

    <button type="submit">Create Dog</button>
  </form>

  <h2>Increase a Dog's Age</h2>

  <form action="/increaseDogAge" method="POST">
    <label for="searchDogName">Dog Name:</label>
    <input type="text" id="searchDogName" name="name" required>
    <br><br>

    <button type="submit">Increase Age</button>
  </form>

</body>

</html>